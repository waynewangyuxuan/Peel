    turns: [...structuredClone(root.turns), turn("turn-4", "Try a compact navigation direction", "A streamed result for this direction.")],
  };
  threads.set(threadId, child);
  return child;
}

function restoreCatalog(threadId) {
  const catalog = catalogThreads.find((thread) => thread.id === threadId);
  if (!catalog) return null;
  const restored = structuredClone(catalog);
  threads.set(threadId, restored);
  return restored;
}

function restoreSynthetic(threadId) {
  if (!String(threadId).startsWith("synthetic-")) return null;
  const synthetic = {
    ...structuredClone(root),
    id: threadId,
    sessionId: `session-${threadId}`,
    name: `Scale direction ${String(threadId).replace("synthetic-", "")}`,
    preview: `Synthetic scale Thread ${threadId}`,
    forkedFromId: root.id,
    parentThreadId: root.id,
    createdAt: now,
    updatedAt: now,
  };
  if (threadId === "synthetic-failed") {
    synthetic.status = { type: "systemError", message: "Synthetic failure" };
    synthetic.turns[synthetic.turns.length - 1].status = "failed";
  }
  threads.set(threadId, synthetic);
  return synthetic;
}

function restorePerformance(threadId) {
  const match = String(threadId).match(/^performance-(10|100|500)(?:-stream-\d+)?$/);
  const boundedBackfill = threadId === "b5000000-0000-4000-8000-000000000500";
  if (!match && !boundedBackfill && threadId !== "performance-oversized") return null;
  const count = boundedBackfill ? 500 : match ? Number(match[1]) : 1;
  const performanceThread = {
    ...structuredClone(root),
    id: threadId,
    sessionId: `session-${threadId}`,
    name: threadId === "performance-oversized" ? "Performance oversized message" : boundedBackfill ? "Bounded backfill 500 Turns" : `Performance ${count} Turns`,
    preview: `Deterministic production Focus fixture for ${threadId}`,
    projectId: null,
    forkedFromId: null,
    parentThreadId: null,
    createdAt: now - count,
    updatedAt: now,
    status: { type: "idle" },
    turns: threadId === "performance-oversized"
      ? [turn("performance-oversized-turn", "Render the oversized response safely", `<script>window.__peelUnsafe = true</script>\n![remote](https://example.com/remote.png)\n${"x".repeat(200_000)}`)]
      : Array.from({ length: count }, (_, index) => boundedBackfill
        ? boundedBackfillTurn("bounded-backfill-500", count, index)
        : performanceTurn(threadId, count, index)),
  };
  threads.set(threadId, performanceThread);
  return performanceThread;
}
