{
  "name": "@peel/codex-app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check:schema": "node scripts/check-installed-schema.mjs",
    "test:live": "npm run build && npm run check:schema && PEEL_CODEX_LIVE_SMOKE=1 node dist/test/live-smoke.js"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
